[alias]
	co = checkout
	st = status
	ci = commit
[user]
	name = Hammer
	# email is set per-machine in ~/.gitconfig.local
[push]
	autoSetupRemote = true
[core]
	excludesfile = ~/.gitignore_global
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = https://github.com/
[include]
	path = ~/.gitconfig.local
