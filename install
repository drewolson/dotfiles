#!/usr/bin/env bash
# Hammer's dotfiles installer. Idempotent: safe to re-run.
#
# Mappings: <repo path>  <target path>
# Targets that already symlink to the right source are skipped silently.
# Targets that are regular files get backed up to <target>.old before symlinking.
#
# Per-machine secrets/settings live in companion *.local files (NOT in this repo):
#   ~/.zshrc.local       sourced from ~/.zshrc
#   ~/.gitconfig.local   included from ~/.gitconfig via git's [include] mechanism

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
DRY_RUN=0
FORCE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=1; shift ;;
        -f|--force)   FORCE=1; shift ;;
        -h|--help)
            echo "Usage: $0 [--dry-run] [--force]"
            echo "  --dry-run   Show what would happen, don't change anything"
            echo "  --force     Overwrite existing files without backing up"
            exit 0
            ;;
        *) echo "Unknown arg: $1" >&2; exit 2 ;;
    esac
done

# repo-relative-source  target-absolute-path
MAPPINGS=(
    "tmux.conf       $HOME/.tmux.conf"
    "zshrc           $HOME/.zshrc"
    "zshenv          $HOME/.zshenv"
    "gitconfig       $HOME/.gitconfig"
    "gitignore       $HOME/.gitignore_global"
    "ghostty/config  $HOME/.config/ghostty/config"
)

link_one() {
    local source_rel="$1" target="$2"
    local source_abs="$REPO_DIR/$source_rel"

    if [ ! -e "$source_abs" ]; then
        printf "  ✗ source missing: %s\n" "$source_abs"
        return 1
    fi

    # Already symlinked correctly?
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source_abs" ]; then
        printf "  ✓ %s -> %s (already linked)\n" "$target" "$source_abs"
        return 0
    fi

    # Make sure parent directory exists
    local target_dir; target_dir="$(dirname "$target")"
    if [ ! -d "$target_dir" ]; then
        if [ "$DRY_RUN" -eq 1 ]; then
            printf "  · mkdir -p %s\n" "$target_dir"
        else
            mkdir -p "$target_dir"
        fi
    fi

    # Handle existing target
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ "$FORCE" -eq 1 ]; then
            if [ "$DRY_RUN" -eq 1 ]; then
                printf "  · rm %s (--force)\n" "$target"
            else
                rm -rf "$target"
            fi
        else
            local backup="$target.old"
            # If a previous .old already exists, append a timestamp
            if [ -e "$backup" ]; then
                backup="$target.old.$(date +%s)"
            fi
            if [ "$DRY_RUN" -eq 1 ]; then
                printf "  · mv %s %s\n" "$target" "$backup"
            else
                mv "$target" "$backup"
            fi
        fi
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        printf "  → ln -s %s %s\n" "$source_abs" "$target"
    else
        ln -s "$source_abs" "$target"
        printf "  ✓ %s -> %s\n" "$target" "$source_abs"
    fi
}

echo "Hammer's dotfiles installer"
echo "==========================="
[ "$DRY_RUN" -eq 1 ] && echo "(dry run — no changes will be made)"
echo

for entry in "${MAPPINGS[@]}"; do
    src=$(echo "$entry" | awk '{print $1}')
    tgt=$(echo "$entry" | awk '{print $2}')
    link_one "$src" "$tgt"
done

echo
echo "Done."
echo
echo "Reminders:"
echo "  - ~/.zshrc.local      should hold per-machine env vars/secrets"
echo "  - ~/.gitconfig.local  should hold per-machine git user.email"
echo "  - Both are gitignored and not tracked in this repo."
